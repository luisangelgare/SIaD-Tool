            <help />
          </parameter>
          <parameter desc="Vdc set point (Vdcref, kV)" name="Vdcref" group="Set Points" unit="kV" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
