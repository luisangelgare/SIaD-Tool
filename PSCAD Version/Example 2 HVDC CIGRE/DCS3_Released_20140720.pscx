      <form name="" w="550" h="700" splitter="80">
        <category name="General" visible="true">
          <cond />
          <parameter desc="Converter Name" name="Name" group="General" type="Text" helpmode="Append">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="Active power set point (Pref, MW)" name="Pref" group="Set Points" unit="MW" min="-1e38" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Active power increase/decrease rates [MW/s]" name="PrefRate" group="Set Points" unit="" min="-1e+308" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[10000]]></value>
            <cond>
            </cond>
            <help>
            </help>
          </parameter>
          <parameter desc="Reacitve power set point (Qref, Mvar)" name="Qref" group="Set Points" unit="Mvar" min="-1e38" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
