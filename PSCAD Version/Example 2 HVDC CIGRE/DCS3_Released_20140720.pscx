    <Definition classid="UserCmpDefn" name="MMC_Levels" url="" version="" build="" crc="21042618" instances="192" key="" view="false" date="1401290531">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="400" h="640" splitter="70">
        <category name="Parameters" visible="true">
          <cond />
          <parameter desc="Switch OFF resistance (for each element)" name="RSOff" group="Cell parameters" unit="ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[1.0e8 [ohm]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Sum of capacitor voltages per arm at t=0 [kV]" name="SumVc0" group="General" unit="kV" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.0 [kV]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated AC voltage" name="Vacbase" group="Rated Values" unit="kV" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[350 [kV]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated MVA" name="Sbase" group="Rated Values" unit="MVA" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[100 [MVA]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable [1] or Disable [0] CCSC" name="CCSCEn" group="CCSC" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cell DC capacitor" name="Cdc" group="Cell parameters" unit="uF" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[3000 [uF]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="AC system frequency" name="fref" group="" unit="Hz" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[50 [Hz]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Smoothing inductance" name="Lsmth" group="General" unit="H" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[1.0e-5 [H]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable [1] or disable [0] mid-point grounding" name="EnGnd" group="" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Switch ON resistance (for each element)" name="RSOn" group="Cell parameters" unit="ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.005 [ohm]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="CCSC regulator gain" name="Kp" group="CCSC" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="CCSC regulator time constant" name="Ti" group="CCSC" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable (1) disable (0) DC bus capacitor" name="DCCapEn" group="DC bus capacitor" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Total DC Bus capacitance" name="DCCap" group="DC bus capacitor" unit="uF" min="1.0e-10" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[25 [uF]]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200">
        <paramlist>
          <param name="show_grid" value="0" />
          <param name="size" value="0" />
