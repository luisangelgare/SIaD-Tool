            <help />
          </parameter>
          <parameter desc="AC voltage set point (Vacref, p.u)" name="Vacref" group="Set Points" unit="p.u." min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
