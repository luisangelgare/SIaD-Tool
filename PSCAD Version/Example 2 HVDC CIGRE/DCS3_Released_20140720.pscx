      <form name="" w="320" h="400" splitter="60">
        <category name="Parameters" visible="true">
          <cond />
          <parameter desc="Smoothing inductance" name="Lsmth" group="General" unit="H" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[1.0e-5 [H]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Sum of capacitor voltages per arm at t=0 [kV]" name="SumVc0" group="General" unit="kV" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.0 [kV]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cell DC capacitor" name="Cdc" group="Cell parameters" unit="uF" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[3000 [uF]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Switch ON resistance (for each element)" name="RSOn" group="Cell parameters" unit="Ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.005 [Ohm]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Switch OFF resistance (for each element)" name="RSOff" group="Cell parameters" unit="Ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[1.0e8 [Ohm]]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
