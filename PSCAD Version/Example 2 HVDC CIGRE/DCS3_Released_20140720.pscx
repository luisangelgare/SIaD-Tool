    <Definition classid="UserCmpDefn" name="DCBreaker" group="" url="" version="" build="" crc="56774299" instances="118" key="" view="false" date="1333775514">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="75">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Time at initilaization that Overcurrent Prot. is disabled" name="TiniOv" group="General" unit="s" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[1.0 [s]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Overcurrent pick up current" name="Ipk" group="" unit="kA" min="1.0e-10" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[2.5 [kA]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="External command (1: Open ; 0: Close)" name="ExtCmd" group="Interlock" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Name" name="Name" group="Interlock" type="Text" helpmode="Append">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="DC current measurement" name="DCI" group="" unit="" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -200 200 200">
        <paramlist>
          <param name="show_grid" value="0" />
          <param name="size" value="0" />
          <param name="orient" value="1" />
          <param name="show_border" value="0" />
          <param name="monitor_bus_voltage" value="0" />
