            <cond />
            <help />
          </parameter>
          <parameter desc="Active power mode (dmode)" name="dmode" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond>
            </cond>
            <help>
            </help>
            <choice><![CDATA[0 = [0]  Vdc control]]></choice>
            <choice><![CDATA[1 = [1]  P control]]></choice>
            <choice><![CDATA[2 = [2] Islanded]]></choice>
