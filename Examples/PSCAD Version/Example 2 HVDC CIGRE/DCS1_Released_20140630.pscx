          <parameter desc="Total DC Bus capacitance" name="DCCap" group="Input" unit="uF" min="1.0e-10" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[25.0 [uF]]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
