          <parameter desc="Overcurrent pick up current" name="Ipk" group="1. General" unit="kA" min="0.0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[2.5 [kA]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Interlock Opening operation?" name="Interlock" group="1. General" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
          </parameter>
          <parameter desc="Differential pick up current" name="Idiff_pk" group="2. Diff. Protection" unit="kA" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0.25 [kA]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Communication delay in signal from other terminal" name="Td" group="2. Diff. Protection" unit="s" min="1.0e-6" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Hold on time (bigger than communication delay)" name="Twait" group="2. Diff. Protection" unit="s" min="1.0e-6" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[25 [ms]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Time at initilaization that Differential Prot. is disabled" name="Tini" group="2. Diff. Protection" unit="s" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input">
            <value><![CDATA[1.0 [s]]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
