      <form name="" w="400" h="400" splitter="75">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Calculated DC bus capacitance to ground (2 x)" name="DCCap2xOut" group="Output" type="Text" helpmode="Append">
            <value><![CDATA[DCCap2x]]></value>
            <cond>
            </cond>
            <help>
            </help>
            <regex>
            </regex>
            <error_msg>
            </error_msg>
