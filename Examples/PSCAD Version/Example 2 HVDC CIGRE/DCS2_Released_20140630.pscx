            <value><![CDATA[50 [mH]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Switch ON resistance (for each element)" name="RSOn" group="Cell parameters" unit="Ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.005 [Ohm]]]></value>
