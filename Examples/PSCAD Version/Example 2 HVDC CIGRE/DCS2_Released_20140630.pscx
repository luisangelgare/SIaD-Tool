    <Definition classid="UserCmpDefn" name="MMC_PWM" url="" version="" build="" crc="33602400" instances="574" key="" view="false" date="1404483177">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="450" h="640" splitter="75">
        <category name="Parameters" visible="true">
          <cond />
          <parameter desc="Switch OFF resistance (for each element)" name="RSOff" group="Cell parameters" unit="ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.0e8 [ohm]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cell blocking delay after fault detection" name="FltClrT" group="DC fault detection" unit="s" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[20 [us]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Pick up time for DC fault detection" name="FltPkT" group="DC fault detection" unit="s" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[100 [us]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Max allowed valve current (valve protection)" name="IvlMax" group="DC fault detection" unit="kA" min="0.0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[2.5 [kA]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Sum of capacitor voltages per arm at t=0 [kV]" name="SumVc0" group="General" unit="kV" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.0 [kV]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cell DC capacitor" name="Cdc" group="Cell parameters" unit="uF" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[3000 [uF]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="AC system frequency" name="fref" group="General" unit="Hz" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[50 [Hz]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Arm inductance" name="Larm" group="" unit="H" min="1e-50" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[50 [mH]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable midpoint ground [1: Enable; 0: Disable]" name="EnGnd" group="" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated AC voltage" name="Vacbase" group="Rated Values" unit="kV" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[350 [kV]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated MVA" name="Sbase" group="Rated Values" unit="MVA" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[100 [MVA]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Switch ON resistance (for each element)" name="RSOn" group="Cell parameters" unit="ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.005 [ohm]]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="CCSC regulator gain" name="Kp" group="CCSC" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="CCSC regulator time constant" name="Ti" group="CCSC" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable [1] or Disable [0] CCSC" name="CCSCEn" group="CCSC" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable (1) disable (0) DC bus capacitor" name="DCCapEn" group="DC bus capacitor" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Total DC Bus capacitance" name="DCCap" group="DC bus capacitor" unit="uF" min="1.0e-10" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[25 [uF]]]></value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
